SECRET_KEY=django-insecure-change-this-in-production
DEBUG=False
DATABASE_URL=postgresql://usuario:contrasena@host:puerto/nombre_db
RAILWAY_ENVIRONMENT=production

# Cloudinary
CLOUDINARY_CLOUD_NAME=tu_cloud_name
CLOUDINARY_API_KEY=tu_api_key
CLOUDINARY_API_SECRET=tu_api_secret

# Flow (Chile)
FLOW_API_KEY=tu_flow_api_key
FLOW_SECRET_KEY=tu_flow_secret_key
FLOW_SANDBOX=False

# MercadoPago
MERCADOPAGO_ACCESS_TOKEN=tu_mercadopago_access_token
MERCADOPAGO_SANDBOX=False

# Starken
STARKEN_TOKEN=tu_starken_token

# Email (Gmail)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=tu_email@gmail.com
EMAIL_HOST_PASSWORD=tu_app_password_de_gmail
DEFAULT_FROM_EMAIL=Mundo Magie <tu_email@gmail.com>

SITE_URL=https://mundomagie.cl
